# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored - never commit real passwords or secrets.

# ---------- MySQL (relational database) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=researchlens

# ---------- Sessions ----------
# Any long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars

# ---------- Qdrant (vector database) ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=paper_embeddings

# ---------- Embedding model (runs locally, downloaded once on first use) ----------
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
